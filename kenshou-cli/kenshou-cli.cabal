cabal-version: 3.0
name: kenshou-cli
version: 0.1.0.0
synopsis: Command-line interface for Keiro runtime verification
description: Operator and automation interface for the Kenshou verification harness.
license: BSD-3-Clause
author: Nadeem Bitar
maintainer: Nadeem Bitar
category: Testing
build-type: Simple
tested-with: ghc >=9.12 && <9.13
extra-source-files: help/*.md

common warnings
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints

  default-language: GHC2024
  default-extensions:
    BlockArguments
    DuplicateRecordFields
    ImportQualifiedPost
    NoFieldSelectors
    OverloadedLabels
    OverloadedRecordDot
    OverloadedStrings

library
  import: warnings
  hs-source-dirs: src
  exposed-modules:
    Kenshou.Cli
    Kenshou.Cli.Cohort
    Kenshou.Cli.Command.Cohort
    Kenshou.Cli.Command.Execute
    Kenshou.Cli.Command.List
    Kenshou.Cli.Command.Plan
    Kenshou.Cli.Command.Run
    Kenshou.Cli.Command.Worker
    Kenshou.Cli.Completions
    Kenshou.Cli.Config
    Kenshou.Cli.Help
    Kenshou.Cli.Help.Width
    Kenshou.Cli.Main
    Kenshou.Cli.Options
    Kenshou.Cli.Registry
    Kenshou.Cli.Version

  other-modules: Paths_kenshou_cli
  build-depends:
    aeson >=2.2 && <2.3,
    base >=4.21 && <4.22,
    bytestring >=0.12 && <0.13,
    containers >=0.7 && <0.8,
    file-embed >=0.0.16 && <0.1,
    filepath >=1.5 && <1.6,
    githash >=0.1.7 && <0.2,
    kenshou-check,
    kenshou-core,
    kenshou-measure,
    optparse-applicative >=0.19 && <0.20,
    random >=1.2.1 && <1.4,
    settei ^>=0.2.0.0,
    settei-env ^>=0.2.0.0,
    settei-optparse-applicative ^>=0.2.0.0,
    temporary,
    terminal-size >=0.3.4 && <0.4,
    text >=2.1 && <2.2,

executable kenshou
  import: warnings
  hs-source-dirs: app
  main-is: Main.hs
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N
    -with-rtsopts=-T

  build-depends:
    base >=4.21 && <4.22,
    kenshou-cli,

test-suite kenshou-cli-test
  import: warnings
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  build-depends:
    base >=4.21 && <4.22,
    hspec >=2.11 && <2.12,
    kenshou-cli,
    text >=2.1 && <2.2,

test-suite kenshou-linkproof
  import: warnings
  type: exitcode-stdio-1.0
  hs-source-dirs: linkproof
  main-is: Main.hs
  other-modules: LinkProof.Imports
  ghc-options: -threaded
  build-depends:
    aeson,
    base,
    effectful,
    effectful-core,
    ephemeral-pg,
    hasql,
    hasql-pool,
    hs-opentelemetry-api,
    hs-opentelemetry-exporter-in-memory,
    hs-opentelemetry-exporter-otlp,
    hs-opentelemetry-propagator-w3c,
    hs-opentelemetry-sdk,
    hs-opentelemetry-semantic-conventions,
    hspec,
    hw-kafka-client,
    hw-kafka-streamly,
    kafka-effectful,
    keiki,
    keiki-codec-json,
    keiro,
    keiro-core,
    keiro-migrations,
    keiro-pgmq,
    keiro-test-support,
    kiroku-cli,
    kiroku-metrics,
    kiroku-otel,
    kiroku-store,
    kiroku-store-migrations,
    pg-migrate,
    pg-migrate-cli,
    pg-migrate-embed,
    pg-migrate-import-codd,
    pg-migrate-import-hasql-migration,
    pgmq-config,
    pgmq-core,
    pgmq-effectful,
    pgmq-hasql,
    pgmq-migration,
    shibuya-core,
    shibuya-kafka-adapter,
    shibuya-kiroku-adapter,
    shibuya-metrics,
    shibuya-pgmq-adapter,
    text,
    vector,

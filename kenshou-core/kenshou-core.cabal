cabal-version: 3.0
name: kenshou-core
version: 0.1.0.0
synopsis: Shared contracts for Keiro runtime verification
description: Shared contracts and utilities for the Kenshou verification harness.
license: BSD-3-Clause
author: Nadeem Bitar
maintainer: Nadeem Bitar
category: Testing
build-type: Simple
tested-with: ghc >=9.12 && <9.13

common warnings
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints

  default-language: GHC2024
  default-extensions:
    BlockArguments
    DuplicateRecordFields
    ImportQualifiedPost
    NoFieldSelectors
    OverloadedLabels
    OverloadedRecordDot
    OverloadedStrings

library
  import: warnings
  hs-source-dirs: src
  exposed-modules:
    Kenshou.Core.Bundle
    Kenshou.Core.Canonical
    Kenshou.Core.Cli
    Kenshou.Core.Cli.Config
    Kenshou.Core.Cohort
    Kenshou.Core.Compat
    Kenshou.Core.Context
    Kenshou.Core.Dimension
    Kenshou.Core.Env
    Kenshou.Core.Env.Migration
    Kenshou.Core.Env.Postgres
    Kenshou.Core.Fingerprint
    Kenshou.Core.Id
    Kenshou.Core.Knob
    Kenshou.Core.Log
    Kenshou.Core.Manifest
    Kenshou.Core.Outcome
    Kenshou.Core.Phase
    Kenshou.Core.Role
    Kenshou.Core.Role.Dispatch
    Kenshou.Core.Role.Spawn
    Kenshou.Core.Run
    Kenshou.Core.RunResult
    Kenshou.Core.RunSpec
    Kenshou.Core.RunSpec.Resolve
    Kenshou.Core.Scenario
    Kenshou.Core.Selector
    Kenshou.Core.Selftest
    Kenshou.Core.Version

  other-modules: Paths_kenshou_core
  build-depends:
    aeson >=2.2 && <2.3,
    base >=4.21 && <4.22,
    base16-bytestring,
    bytestring >=0.12 && <0.13,
    containers >=0.7 && <0.8,
    cryptohash-sha256 >=0.11 && <0.12,
    directory,
    ephemeral-pg >=0.3.1 && <0.4,
    filepath >=1.5 && <1.6,
    hasql >=1.10 && <1.11,
    keiro-migrations,
    kiroku-store-migrations,
    mmzk-typeid >=0.7 && <0.8,
    optparse-applicative >=0.19 && <0.20,
    pg-migrate ^>=1.1.0.0,
    pgmq-migration,
    process,
    random >=1.2.1 && <1.4,
    scientific,
    settei ^>=0.2.0.0,
    settei-optparse-applicative ^>=0.2.0.0,
    settei-yaml ^>=0.2.0.0,
    splitmix,
    text >=2.1 && <2.2,
    time,
    unix,
    uuid >=1.3 && <1.4,
    vector,

test-suite kenshou-core-test
  import: warnings
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  build-depends:
    aeson >=2.2 && <2.3,
    base >=4.21 && <4.22,
    bytestring,
    containers,
    hedgehog >=1.4 && <1.8,
    hspec >=2.11 && <2.12,
    hspec-hedgehog >=0.0 && <0.4,
    kenshou-core,
    process,
    temporary,
    text >=2.1 && <2.2,

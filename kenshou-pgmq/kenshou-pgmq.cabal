cabal-version: 3.0
name: kenshou-pgmq
version: 0.1.0.0
synopsis: Isolated verification scenarios for pgmq-hs
description: Correctness, concurrency, benchmark, soak, and telemetry probes for pgmq-hs.
license: BSD-3-Clause
author: Nadeem Bitar
maintainer: Nadeem Bitar
category: Testing
build-type: Simple
tested-with: ghc >=9.12 && <9.13

common warnings
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints

  default-language: GHC2024
  default-extensions:
    BlockArguments
    DeriveAnyClass
    DeriveGeneric
    DuplicateRecordFields
    ImportQualifiedPost
    LambdaCase
    NoFieldSelectors
    OverloadedLabels
    OverloadedRecordDot
    OverloadedStrings
    TypeApplications

library
  import: warnings
  hs-source-dirs: src
  exposed-modules:
    Kenshou.Suite.Pgmq
    Kenshou.Suite.Pgmq.Bench.Backlog
    Kenshou.Suite.Pgmq.Bench.Fifo
    Kenshou.Suite.Pgmq.Bench.Ladder
    Kenshou.Suite.Pgmq.Bench.Notify
    Kenshou.Suite.Pgmq.Bench.Overhead
    Kenshou.Suite.Pgmq.Bench.ProduceConsume
    Kenshou.Suite.Pgmq.Bench.ReadAck
    Kenshou.Suite.Pgmq.Bench.Send
    Kenshou.Suite.Pgmq.Catalog
    Kenshou.Suite.Pgmq.Client
    Kenshou.Suite.Pgmq.Concurrency.Config
    Kenshou.Suite.Pgmq.Concurrency.Crash
    Kenshou.Suite.Pgmq.Concurrency.Fifo
    Kenshou.Suite.Pgmq.Concurrency.Lease
    Kenshou.Suite.Pgmq.Concurrency.Notify
    Kenshou.Suite.Pgmq.Concurrency.Outage
    Kenshou.Suite.Pgmq.Concurrency.Pool
    Kenshou.Suite.Pgmq.Concurrency.Retention
    Kenshou.Suite.Pgmq.Correctness.Ack
    Kenshou.Suite.Pgmq.Correctness.Config
    Kenshou.Suite.Pgmq.Correctness.Effectful
    Kenshou.Suite.Pgmq.Correctness.Fifo
    Kenshou.Suite.Pgmq.Correctness.Notify
    Kenshou.Suite.Pgmq.Correctness.Queue
    Kenshou.Suite.Pgmq.Correctness.Read
    Kenshou.Suite.Pgmq.Correctness.Send
    Kenshou.Suite.Pgmq.Correctness.Topics
    Kenshou.Suite.Pgmq.Correctness.Vt
    Kenshou.Suite.Pgmq.Facts
    Kenshou.Suite.Pgmq.Harness
    Kenshou.Suite.Pgmq.Knobs
    Kenshou.Suite.Pgmq.Listener
    Kenshou.Suite.Pgmq.Oracle
    Kenshou.Suite.Pgmq.RawSql
    Kenshou.Suite.Pgmq.Roles
    Kenshou.Suite.Pgmq.Soak.SteadyState
    Kenshou.Suite.Pgmq.Telemetry
    Kenshou.Suite.Pgmq.TopicModel

  build-depends:
    aeson >=2.2 && <2.3,
    async >=2.2 && <2.3,
    base >=4.21 && <4.22,
    bytestring >=0.12 && <0.13,
    containers >=0.7 && <0.8,
    effectful >=2.6 && <2.7,
    effectful-core >=2.6 && <2.7,
    hasql >=1.10 && <1.11,
    hasql-pool >=1.4 && <1.5,
    hs-opentelemetry-api >=1.0 && <1.1,
    kenshou-check,
    kenshou-core,
    kenshou-diagnose,
    kenshou-measure,
    kenshou-telemetry,
    pgmq-config ==0.6.1.0,
    pgmq-core ==0.6.1.0,
    pgmq-effectful ==0.6.1.0,
    pgmq-hasql ==0.6.1.0,
    postgresql-libpq >=0.10.1 && <0.12,
    random >=1.2.1 && <1.4,
    stm >=2.5 && <2.6,
    text >=2.1 && <2.2,
    time >=1.12 && <1.15,
    vector >=0.13 && <0.14,

test-suite kenshou-pgmq-test
  import: warnings
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  build-depends:
    base >=4.21 && <4.22,
    containers >=0.7 && <0.8,
    directory,
    filepath,
    hspec >=2.11 && <2.12,
    kenshou-core,
    kenshou-pgmq,
    pgmq-core ==0.6.1.0,
    text >=2.1 && <2.2,
    time >=1.12 && <1.15,

cabal-version: 3.0
name: kenshou-kiroku
version: 0.1.0.0
synopsis: Isolated verification scenarios for kiroku
license: BSD-3-Clause
author: Nadeem Bitar
maintainer: Nadeem Bitar
build-type: Simple
tested-with: ghc >=9.12 && <9.13

common warnings
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints

  default-language: GHC2024
  default-extensions:
    BlockArguments
    DeriveAnyClass
    DeriveGeneric
    DuplicateRecordFields
    ImportQualifiedPost
    LambdaCase
    NoFieldSelectors
    OverloadedLabels
    OverloadedRecordDot
    OverloadedStrings
    TypeApplications

library
  import: warnings
  hs-source-dirs: src
  exposed-modules:
    Kenshou.Suite.Kiroku
    Kenshou.Suite.Kiroku.Concurrency.Append
    Kenshou.Suite.Kiroku.Correctness.Append
    Kenshou.Suite.Kiroku.Correctness.ConsumerGroup
    Kenshou.Suite.Kiroku.Correctness.DeadLetter
    Kenshou.Suite.Kiroku.Correctness.Lifecycle
    Kenshou.Suite.Kiroku.Correctness.Metrics
    Kenshou.Suite.Kiroku.Correctness.Notifier
    Kenshou.Suite.Kiroku.Correctness.Otel
    Kenshou.Suite.Kiroku.Correctness.Overflow
    Kenshou.Suite.Kiroku.Correctness.Read
    Kenshou.Suite.Kiroku.Correctness.Retention
    Kenshou.Suite.Kiroku.Correctness.Subscription
    Kenshou.Suite.Kiroku.Correctness.Transaction
    Kenshou.Suite.Kiroku.Fixture.Store
    Kenshou.Suite.Kiroku.Knobs
    Kenshou.Suite.Kiroku.Roles

  build-depends:
    aeson >=2.2 && <2.3,
    base >=4.21 && <4.22,
    bytestring >=0.12 && <0.13,
    containers >=0.7 && <0.8,
    effectful >=2.6 && <2.7,
    filepath,
    hasql >=1.10 && <1.11,
    hasql-pool >=1.4 && <1.5,
    hasql-transaction >=1.0 && <2,
    hs-opentelemetry-api ==1.0.0.0,
    http-client >=0.7 && <0.8,
    http-types >=0.12 && <0.13,
    kenshou-check,
    kenshou-core,
    kenshou-telemetry,
    kiroku-metrics ==0.1.0.8,
    kiroku-otel ==0.2.0.8,
    kiroku-store ==0.8.0.1,
    stm >=2.5 && <2.6,
    streamly-core >=0.3 && <0.4,
    text >=2.1 && <2.2,
    time >=1.12 && <1.15,
    uuid >=1.3 && <1.4,
    vector >=0.13 && <0.14,
    websockets >=0.13 && <0.14,

test-suite kenshou-kiroku-test
  import: warnings
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  build-depends:
    base >=4.21 && <4.22,
    hspec >=2.11 && <2.12,
    kenshou-core,
    kenshou-kiroku,

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kenshou.invalid/schemas/comparison-v1.schema.json",
  "$defs": {
    "policy": {
      "type": "object",
      "required": ["schema", "name", "minimumPairs", "confidenceLevel", "bootstrapIterations", "resamplingSeed", "requireInterleaving", "requireGrade", "maxCiRelativeWidth", "maxCheckpointAsymmetry", "metrics"],
      "properties": {
        "schema": {"const": "kenshou.comparison-policy/v1"},
        "name": {"type": "string"},
        "minimumPairs": {"type": "integer", "minimum": 3},
        "confidenceLevel": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "bootstrapIterations": {"type": "integer", "minimum": 1000},
        "resamplingSeed": {"type": "integer", "minimum": 0},
        "requireInterleaving": {"type": "boolean"},
        "requireGrade": {"enum": ["benchmark", "exploratory"]},
        "maxCiRelativeWidth": {"type": "number", "minimum": 0},
        "maxCheckpointAsymmetry": {"type": "number", "minimum": 0},
        "metrics": {"type": "array"}
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["schema", "comparisonId", "algorithm", "policy", "variedFactors", "pairCount", "metrics", "reasons", "verdict", "exitCode"],
  "properties": {
    "schema": {"const": "kenshou.comparison/v1"},
    "comparisonId": {"type": "string"},
    "algorithm": {"type": "object"},
    "policy": {"$ref": "#/$defs/policy"},
    "variedFactors": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "pairCount": {"type": "integer", "minimum": 1},
    "metrics": {"type": "object"},
    "reasons": {"type": "array", "items": {"type": "string"}},
    "verdict": {"enum": ["pass", "regression", "inconclusive", "infrastructure-failure"]},
    "exitCode": {"enum": [0, 1, 3, 4]}
  },
  "additionalProperties": false
}

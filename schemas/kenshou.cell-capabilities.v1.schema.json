{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kenshou.invalid/schemas/kenshou.cell-capabilities.v1.schema.json",
  "type": "object",
  "required": ["schema", "cell", "descriptorSha256", "probedBy", "probedAt", "capabilities"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "kenshou.cell-capabilities/v1"},
    "cell": {"type": "string", "minLength": 1},
    "descriptorSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "probedBy": {"type": "string", "format": "uuid"},
    "probedAt": {"type": "string", "format": "date-time"},
    "capabilities": {"type": "object", "additionalProperties": {"type": ["boolean", "string", "number"]}}
  }
}

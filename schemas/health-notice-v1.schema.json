{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kenshou.invalid/schemas/health-notice-v1.schema.json",
  "type": "object",
  "required": ["schema", "source", "severity", "at", "detail"],
  "properties": {
    "schema": {"const": "kenshou.health-notice/v1"},
    "source": {"type": "string", "minLength": 1},
    "severity": {"enum": ["soft", "hard"]},
    "at": {"type": "string", "format": "date-time"},
    "detail": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}

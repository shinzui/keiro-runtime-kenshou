{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "kenshou.perf-prepared/v1"
    },
    "plan": {
      "$ref": "kenshou.perf-plan.v1.schema.json"
    },
    "inputs": {
      "type": "object"
    },
    "harnessRevision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "baseline": {
      "$ref": "#/$defs/arm"
    },
    "candidate": {
      "$ref": "#/$defs/arm"
    }
  },
  "required": [
    "schema",
    "plan",
    "inputs",
    "harnessRevision",
    "baseline",
    "candidate"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "package": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "object"
        },
        "flags": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "settings": {
          "type": "object"
        }
      },
      "required": [
        "name",
        "version",
        "source",
        "flags",
        "settings"
      ]
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resolver": {
          "enum": [
            "nix",
            "cabal-bounds"
          ]
        },
        "compiler": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "toolchain": {
          "type": "object"
        },
        "packages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/package"
          }
        }
      },
      "required": [
        "resolver",
        "compiler",
        "platform",
        "toolchain",
        "packages"
      ]
    },
    "arm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "descriptor": {
          "type": "object"
        },
        "sourceLock": {
          "$ref": "kenshou.cohort-nix-lock.v1.schema.json"
        },
        "boundsInventory": {
          "$ref": "#/$defs/inventory"
        },
        "buildInventory": {
          "$ref": "#/$defs/inventory"
        },
        "payload": {
          "$ref": "kenshou.payload.v1.schema.json"
        },
        "buildKey": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "descriptor",
        "sourceLock",
        "boundsInventory",
        "buildInventory",
        "payload",
        "buildKey"
      ]
    }
  }
}

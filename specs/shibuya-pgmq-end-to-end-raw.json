{
  "schema": "kenshou.run-spec/v1",
  "scenario": "shibuya/pgmq-adapter/benchmark/end-to-end-throughput-latency",
  "dimensions": { "pg.version": "18" },
  "knobs": {
    "bench.arm": "raw-client",
    "bench.rate": 200,
    "shibuya.messages": 1000,
    "pgmq-adapter.batch-size": 10,
    "pgmq-adapter.polling": "standard:1",
    "pgmq-adapter.prefetch-buffer-size": 0,
    "shibuya.concurrency": "async:4",
    "pgmq-adapter.pool-size": 10,
    "bench.payload-bytes": 256
  },
  "environment": { "placement": "local", "postgres": { "mode": "ephemeral" } }
}

cabal-version: 3.4
name: kenshou-shibuya
version: 0.1.0.0
synopsis: Isolated verification scenarios for shibuya
license: BSD-3-Clause
author: Nadeem Bitar
maintainer: Nadeem Bitar
build-type: Simple
tested-with: ghc >=9.12 && <9.13

common defaults
  default-language: GHC2024
  default-extensions:
    DuplicateRecordFields
    LambdaCase
    NoFieldSelectors
    OverloadedRecordDot
    OverloadedStrings

  ghc-options: -Wall

library
  import: defaults
  hs-source-dirs: src
  exposed-modules:
    Kenshou.Suite.Shibuya
    Kenshou.Suite.Shibuya.Cohort
    Kenshou.Suite.Shibuya.Concurrency.CoreBatch
    Kenshou.Suite.Shibuya.Concurrency.CoreOrdering
    Kenshou.Suite.Shibuya.Concurrency.CoreRunner
    Kenshou.Suite.Shibuya.Correctness.CoreBatch
    Kenshou.Suite.Shibuya.Correctness.CoreOrdering
    Kenshou.Suite.Shibuya.Correctness.CoreRunner
    Kenshou.Suite.Shibuya.Correctness.Metrics
    Kenshou.Suite.Shibuya.Fixture.Handlers
    Kenshou.Suite.Shibuya.Fixture.RestartLoop
    Kenshou.Suite.Shibuya.Fixture.SyntheticAdapter
    Kenshou.Suite.Shibuya.Knobs
    Kenshou.Suite.Shibuya.Matrix

  build-depends:
    aeson >=2.2 && <2.3,
    async >=2.2 && <2.3,
    base >=4.21 && <4.22,
    bytestring >=0.12 && <0.13,
    containers >=0.7 && <0.8,
    effectful-core >=2.6 && <2.7,
    http-client,
    http-types,
    kenshou-core,
    kenshou-telemetry,
    shibuya-core,
    shibuya-metrics,
    stm >=2.5 && <2.6,
    streamly-core >=0.3 && <0.4,
    text >=2.1 && <2.2,
    time >=1.12 && <1.15,
    websockets,

test-suite kenshou-shibuya-test
  import: defaults
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  other-modules:
    MetricsSpec
    SyntheticSpec

  ghc-options: -threaded
  build-depends:
    base >=4.21 && <4.22,
    effectful-core >=2.6 && <2.7,
    hedgehog >=1.4 && <1.8,
    hspec >=2.11 && <2.12,
    hspec-hedgehog >=0.0 && <0.4,
    kenshou-core,
    kenshou-shibuya,
    shibuya-core,
    stm >=2.5 && <2.6,
    text >=2.1 && <2.2,
    time >=1.12 && <1.15,

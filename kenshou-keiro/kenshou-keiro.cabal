cabal-version: 3.4
name: kenshou-keiro
version: 0.1.0.0
synopsis: Verification scenarios for the keiro write side
license: BSD-3-Clause
author: Nadeem Bitar
maintainer: Nadeem Bitar
build-type: Simple
tested-with: ghc >=9.12 && <9.13

common warnings
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints

  default-language: GHC2024
  default-extensions:
    BlockArguments
    DeriveAnyClass
    DeriveGeneric
    DuplicateRecordFields
    ImportQualifiedPost
    LambdaCase
    NoFieldSelectors
    OverloadedLabels
    OverloadedRecordDot
    OverloadedStrings
    QualifiedDo
    TemplateHaskell
    TypeApplications

library
  import: warnings
  hs-source-dirs: src
  exposed-modules:
    Kenshou.Suite.Keiro
    Kenshou.Suite.Keiro.Command.Bench
    Kenshou.Suite.Keiro.Command.Concurrency
    Kenshou.Suite.Keiro.Command.Correctness
    Kenshou.Suite.Keiro.Command.Projection
    Kenshou.Suite.Keiro.Fixture.Account
    Kenshou.Suite.Keiro.Fixture.Bonus
    Kenshou.Suite.Keiro.Fixture.Bridge
    Kenshou.Suite.Keiro.Fixture.Domain
    Kenshou.Suite.Keiro.Fixture.Model
    Kenshou.Suite.Keiro.Fixture.Oracle
    Kenshou.Suite.Keiro.Fixture.Projection
    Kenshou.Suite.Keiro.Fixture.Roles
    Kenshou.Suite.Keiro.Fixture.Runtime
    Kenshou.Suite.Keiro.Fixture.Transfer
    Kenshou.Suite.Keiro.Fixture.Workload
    Kenshou.Suite.Keiro.ProcessManager.Concurrency
    Kenshou.Suite.Keiro.ProcessManager.Correctness
    Kenshou.Suite.Keiro.Router.Concurrency
    Kenshou.Suite.Keiro.Router.Correctness

  build-depends:
    aeson,
    async,
    base,
    bytestring,
    containers,
    effectful,
    filepath,
    hasql,
    hasql-transaction,
    hedgehog,
    keiki,
    keiki-codec-json,
    keiro,
    keiro-core,
    kenshou-check,
    kenshou-core,
    kenshou-measure,
    kenshou-telemetry,
    kiroku-store,
    random,
    shibuya-core,
    shibuya-kiroku-adapter,
    stm,
    streamly,
    streamly-core,
    text,
    time,
    uuid,
    vector,

test-suite kenshou-keiro-test
  import: warnings
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N

  build-depends:
    aeson,
    base,
    effectful,
    hedgehog,
    hspec,
    hspec-hedgehog,
    keiki,
    keiro,
    keiro-core,
    kenshou-keiro,
    kiroku-store,
    shibuya-core,
    streamly-core,
    text,
    time,
    uuid,

cabal-version: 3.4
name: kenshou-keiro
version: 0.1.0.0
synopsis: Verification scenarios for the keiro write side
license: BSD-3-Clause
author: Nadeem Bitar
maintainer: Nadeem Bitar
build-type: Simple
tested-with: ghc >=9.12 && <9.13

common warnings
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints

  default-language: GHC2024
  default-extensions:
    BlockArguments
    DeriveAnyClass
    DeriveGeneric
    DuplicateRecordFields
    ImportQualifiedPost
    LambdaCase
    NoFieldSelectors
    OverloadedLabels
    OverloadedRecordDot
    OverloadedStrings
    QualifiedDo
    TemplateHaskell
    TypeApplications

library
  import: warnings
  hs-source-dirs: src
  exposed-modules:
    Kenshou.Suite.Keiro
    Kenshou.Suite.Keiro.Command.Bench
    Kenshou.Suite.Keiro.Command.Concurrency
    Kenshou.Suite.Keiro.Command.Correctness
    Kenshou.Suite.Keiro.Command.Projection
    Kenshou.Suite.Keiro.Command.Soak
    Kenshou.Suite.Keiro.Command.SteadyState
    Kenshou.Suite.Keiro.Fixture.Account
    Kenshou.Suite.Keiro.Fixture.Bonus
    Kenshou.Suite.Keiro.Fixture.Bridge
    Kenshou.Suite.Keiro.Fixture.Domain
    Kenshou.Suite.Keiro.Fixture.Model
    Kenshou.Suite.Keiro.Fixture.Oracle
    Kenshou.Suite.Keiro.Fixture.Projection
    Kenshou.Suite.Keiro.Fixture.Roles
    Kenshou.Suite.Keiro.Fixture.Runtime
    Kenshou.Suite.Keiro.Fixture.Transfer
    Kenshou.Suite.Keiro.Fixture.Workload
    Kenshou.Suite.Keiro.Inbox
    Kenshou.Suite.Keiro.Inbox.Concurrency
    Kenshou.Suite.Keiro.Inbox.Correctness
    Kenshou.Suite.Keiro.Inbox.Roles
    Kenshou.Suite.Keiro.Messaging.Verdict
    Kenshou.Suite.Keiro.Outbox
    Kenshou.Suite.Keiro.Outbox.Broker
    Kenshou.Suite.Keiro.Outbox.Concurrency
    Kenshou.Suite.Keiro.Outbox.Correctness
    Kenshou.Suite.Keiro.Outbox.Oracle
    Kenshou.Suite.Keiro.Outbox.ProducerIdentity
    Kenshou.Suite.Keiro.Outbox.Roles
    Kenshou.Suite.Keiro.Outbox.Workload
    Kenshou.Suite.Keiro.ProcessManager.Bench
    Kenshou.Suite.Keiro.ProcessManager.Concurrency
    Kenshou.Suite.Keiro.ProcessManager.Correctness
    Kenshou.Suite.Keiro.Queue
    Kenshou.Suite.Keiro.Queue.Concurrency
    Kenshou.Suite.Keiro.Queue.Correctness
    Kenshou.Suite.Keiro.Queue.Roles
    Kenshou.Suite.Keiro.Router.Bench
    Kenshou.Suite.Keiro.Router.Concurrency
    Kenshou.Suite.Keiro.Router.Correctness
    Kenshou.Suite.Keiro.Shard
    Kenshou.Suite.Keiro.Shard.LeaseSmoke
    Kenshou.Suite.Keiro.Shard.Mismatch
    Kenshou.Suite.Keiro.Shard.Oracle
    Kenshou.Suite.Keiro.Shard.Roles
    Kenshou.Suite.Keiro.Telemetry
    Kenshou.Suite.Keiro.Timer
    Kenshou.Suite.Keiro.Timer.Correctness
    Kenshou.Suite.Keiro.Timer.Oracle
    Kenshou.Suite.Keiro.Workflow
    Kenshou.Suite.Keiro.Workflow.AwakeableSmoke
    Kenshou.Suite.Keiro.Workflow.ChildSmoke
    Kenshou.Suite.Keiro.Workflow.CrashSmoke
    Kenshou.Suite.Keiro.Workflow.Definitions
    Kenshou.Suite.Keiro.Workflow.Effects
    Kenshou.Suite.Keiro.Workflow.ExactDiscovery
    Kenshou.Suite.Keiro.Workflow.Fixture
    Kenshou.Suite.Keiro.Workflow.Knobs
    Kenshou.Suite.Keiro.Workflow.LinearSmoke
    Kenshou.Suite.Keiro.Workflow.Oracle
    Kenshou.Suite.Keiro.Workflow.PatchSmoke
    Kenshou.Suite.Keiro.Workflow.Roles
    Kenshou.Suite.Keiro.Workflow.RotationSmoke
    Kenshou.Suite.Keiro.Workflow.SleepSmoke

  build-depends:
    aeson,
    async,
    base,
    bytestring,
    containers,
    contravariant,
    directory,
    effectful,
    filepath,
    hasql,
    hasql-pool,
    hasql-transaction,
    hedgehog,
    hs-opentelemetry-api,
    keiki,
    keiki-codec-json,
    keiro,
    keiro-core,
    keiro-pgmq,
    kenshou-check,
    kenshou-core,
    kenshou-diagnose,
    kenshou-measure,
    kenshou-telemetry,
    kiroku-store,
    pgmq-core,
    pgmq-effectful,
    random,
    shibuya-core,
    shibuya-kiroku-adapter,
    shibuya-pgmq-adapter,
    stm,
    streamly,
    streamly-core,
    text,
    time,
    unix,
    uuid,
    vector,

test-suite kenshou-keiro-test
  import: warnings
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N

  build-depends:
    aeson,
    base,
    bytestring,
    containers,
    effectful,
    hedgehog,
    hspec,
    hspec-hedgehog,
    keiki,
    keiro,
    keiro-core,
    kenshou-core,
    kenshou-keiro,
    kiroku-store,
    shibuya-core,
    streamly-core,
    text,
    time,
    uuid,

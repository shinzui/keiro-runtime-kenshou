cabal-version: 3.0
name: kenshou-measure
version: 0.1.0.0
synopsis: Measurement and comparison toolkit for Kenshou scenarios
description: Load generation, latency recording, sampling, summaries, health gates, and paired comparisons.
license: BSD-3-Clause
author: Nadeem Bitar
maintainer: Nadeem Bitar
category: Testing
build-type: Simple
tested-with: ghc >=9.12 && <9.13
extra-source-files:
  test/fixtures/health-notice.json
  test/fixtures/proc/host-stat.txt
  test/fixtures/proc/loadavg.txt
  test/fixtures/proc/meminfo.txt
  test/fixtures/proc/stat.txt
  test/fixtures/proc/status.txt
  test/golden/histogram-v1.hex

common warnings
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints

  default-language: GHC2024
  default-extensions:
    BlockArguments
    DuplicateRecordFields
    ImportQualifiedPost
    NoFieldSelectors
    OverloadedLabels
    OverloadedRecordDot
    OverloadedStrings

library
  import: warnings
  hs-source-dirs: src
  exposed-modules:
    Kenshou.Measure
    Kenshou.Measure.Cli
    Kenshou.Measure.Clock
    Kenshou.Measure.Compare
    Kenshou.Measure.Compare.Compatibility
    Kenshou.Measure.Compare.Ordering
    Kenshou.Measure.Compare.Policy
    Kenshou.Measure.Health
    Kenshou.Measure.Histogram
    Kenshou.Measure.Histogram.Codec
    Kenshou.Measure.Knobs
    Kenshou.Measure.Load
    Kenshou.Measure.Load.Arrival
    Kenshou.Measure.Load.Closed
    Kenshou.Measure.Load.Open
    Kenshou.Measure.Load.Series
    Kenshou.Measure.Load.Types
    Kenshou.Measure.Methodology
    Kenshou.Measure.Metrics
    Kenshou.Measure.Phase
    Kenshou.Measure.Recorder
    Kenshou.Measure.Sampler
    Kenshou.Measure.Sampler.Csv
    Kenshou.Measure.Sampler.Host
    Kenshou.Measure.Sampler.Postgres
    Kenshou.Measure.Sampler.Process
    Kenshou.Measure.Sampler.Rts
    Kenshou.Measure.Samples
    Kenshou.Measure.Selftest
    Kenshou.Measure.Selftest.PgInsert
    Kenshou.Measure.Selftest.RegressionInjected
    Kenshou.Measure.Selftest.SleepService
    Kenshou.Measure.Session
    Kenshou.Measure.Stats
    Kenshou.Measure.Summary

  build-depends:
    aeson >=2.2 && <2.3,
    async,
    base >=4.21 && <4.22,
    bytestring >=0.12 && <0.13,
    containers >=0.7 && <0.8,
    directory,
    filepath >=1.5 && <1.6,
    hasql >=1.10 && <1.11,
    kenshou-core,
    optparse-applicative >=0.19 && <0.20,
    primitive >=0.9 && <0.10,
    process >=1.6 && <1.7,
    splitmix >=0.1 && <0.2,
    stm,
    text >=2.1 && <2.2,
    time,
    unix,

  if os(osx)
    c-sources: cbits/kenshou_proc_darwin.c

test-suite kenshou-measure-test
  import: warnings
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  other-modules:
    Kenshou.Measure.ClockSpec
    Kenshou.Measure.CompareSpec
    Kenshou.Measure.HistogramSpec
    Kenshou.Measure.LoadSpec
    Kenshou.Measure.RecorderSpec
    Kenshou.Measure.SamplerSpec
    Kenshou.Measure.SamplesSpec

  build-depends:
    aeson,
    base >=4.21 && <4.22,
    bytestring,
    directory,
    filepath,
    hedgehog >=1.4 && <1.8,
    hspec >=2.11 && <2.12,
    hspec-hedgehog >=0.0 && <0.4,
    kenshou-core,
    kenshou-measure,
    splitmix >=0.1 && <0.2,
    temporary,
    text,
    time,

cabal-version: 3.0
name: kenshou-measure
version: 0.1.0.0
synopsis: Measurement and comparison toolkit for Kenshou scenarios
description: Load generation, latency recording, sampling, summaries, health gates, and paired comparisons.
license: BSD-3-Clause
author: Nadeem Bitar
maintainer: Nadeem Bitar
category: Testing
build-type: Simple
tested-with: ghc >=9.12 && <9.13
extra-source-files:
  test/golden/histogram-v1.hex

common warnings
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints

  default-language: GHC2024
  default-extensions:
    BlockArguments
    DuplicateRecordFields
    ImportQualifiedPost
    NoFieldSelectors
    OverloadedLabels
    OverloadedRecordDot
    OverloadedStrings

library
  import: warnings
  hs-source-dirs: src
  exposed-modules:
    Kenshou.Measure
    Kenshou.Measure.Clock
    Kenshou.Measure.Histogram
    Kenshou.Measure.Histogram.Codec
    Kenshou.Measure.Knobs
    Kenshou.Measure.Load
    Kenshou.Measure.Load.Arrival
    Kenshou.Measure.Load.Closed
    Kenshou.Measure.Load.Open
    Kenshou.Measure.Load.Types
    Kenshou.Measure.Phase
    Kenshou.Measure.Recorder
    Kenshou.Measure.Samples
    Kenshou.Measure.Selftest
    Kenshou.Measure.Selftest.SleepService
    Kenshou.Measure.Session

  build-depends:
    aeson >=2.2 && <2.3,
    async,
    base >=4.21 && <4.22,
    bytestring >=0.12 && <0.13,
    containers >=0.7 && <0.8,
    directory,
    filepath >=1.5 && <1.6,
    kenshou-core,
    primitive >=0.9 && <0.10,
    splitmix >=0.1 && <0.2,
    stm,
    text >=2.1 && <2.2,
    time,

test-suite kenshou-measure-test
  import: warnings
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  other-modules:
    Kenshou.Measure.ClockSpec
    Kenshou.Measure.HistogramSpec
    Kenshou.Measure.LoadSpec
    Kenshou.Measure.RecorderSpec
    Kenshou.Measure.SamplesSpec

  build-depends:
    base >=4.21 && <4.22,
    bytestring,
    directory,
    filepath,
    hedgehog >=1.4 && <1.8,
    hspec >=2.11 && <2.12,
    hspec-hedgehog >=0.0 && <0.4,
    kenshou-measure,
    splitmix >=0.1 && <0.2,
    temporary,
    text,
    time,

cabal-version: 3.0
name: kenshou-evidence
version: 0.1.0.0
synopsis: Historic verification records and durable object storage
description: Evidence types and storage boundaries for Kenshou run records.
license: BSD-3-Clause
author: Nadeem Bitar
maintainer: Nadeem Bitar
category: Testing
build-type: Simple
tested-with: ghc >=9.12 && <9.13

common warnings
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints

  default-language: GHC2024
  default-extensions:
    BlockArguments
    DuplicateRecordFields
    ImportQualifiedPost
    NoFieldSelectors
    OverloadedRecordDot
    OverloadedStrings

library
  import: warnings
  hs-source-dirs: src
  exposed-modules:
    Kenshou.Evidence.Bundle
    Kenshou.Evidence.Cli
    Kenshou.Evidence.Frontmatter
    Kenshou.Evidence.Publish
    Kenshou.Evidence.Record
    Kenshou.Evidence.Source
    Kenshou.Evidence.Store
    Kenshou.Evidence.Types

  build-depends:
    aeson >=2.2 && <2.3,
    base >=4.21 && <4.22,
    bytestring >=0.12 && <0.13,
    containers >=0.7 && <0.8,
    directory,
    filepath >=1.5 && <1.6,
    kenshou-core,
    okf-core ^>=0.9.0.0,
    optparse-applicative >=0.19 && <0.20,
    process,
    temporary,
    text >=2.1 && <2.2,
    time,
    transformers,
    unix,

test-suite kenshou-evidence-test
  import: warnings
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  build-depends:
    aeson,
    base >=4.21 && <4.22,
    bytestring,
    containers,
    directory,
    filepath,
    hspec >=2.11 && <2.12,
    kenshou-core,
    kenshou-evidence,
    okf-core,
    temporary,
    text,
    time,

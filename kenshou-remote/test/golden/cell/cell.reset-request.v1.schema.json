{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shinzui.dev/load-testing-infra/schemas/cell/cell.reset-request.v1.schema.json",
  "title": "Lease-authorized role reset request",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "runId", "leaseId", "reset"],
  "properties": {
    "schema": {"const": "cell.reset-request/v1"},
    "runId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,62}$"},
    "leaseId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,62}$"},
    "reset": {
      "type": "object", "additionalProperties": false,
      "required": ["cachePolicy"],
      "properties": {
        "cachePolicy": {"enum": ["cold", "warm"]},
        "postgres": {
          "type": "object", "additionalProperties": false,
          "required": ["major", "databases", "settings"],
          "properties": {
            "major": {"enum": [17, 18]},
            "databases": {
              "type": "array", "uniqueItems": true,
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["name", "owner", "template"],
                "properties": {
                  "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$"},
                  "owner": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$"},
                  "template": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$"}
                }
              }
            },
            "settings": {"type": "object", "additionalProperties": {"type": "string"}, "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"}}
          }
        },
        "broker": {
          "type": "object", "additionalProperties": false,
          "required": ["wipe"],
          "properties": {"wipe": {"type": "boolean"}}
        }
      }
    }
  }
}

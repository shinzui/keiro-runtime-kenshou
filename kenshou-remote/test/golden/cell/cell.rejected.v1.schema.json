{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shinzui.dev/load-testing-infra/schemas/cell/cell.rejected.v1.schema.json",
  "title": "Rejected verification cell submission",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "runId", "reason", "at"],
  "properties": {
    "schema": {"const": "cell.rejected/v1"},
    "runId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,62}$"},
    "reason": {"type": "string", "minLength": 1},
    "at": {"type": "string", "format": "date-time"}
  }
}

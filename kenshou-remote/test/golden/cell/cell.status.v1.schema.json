{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shinzui.dev/load-testing-infra/schemas/cell/cell.status.v1.schema.json",
  "title": "Verification cell submission status",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "runId", "phase", "updatedAt", "logChunks"],
  "properties": {
    "schema": {"const": "cell.status/v1"},
    "runId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,62}$"},
    "phase": {"enum": ["accepted", "resetting", "fetching", "running", "publishing", "sealed"]},
    "leaseSequence": {"type": "integer", "minimum": 0},
    "updatedAt": {"type": "string", "format": "date-time"},
    "phaseStartedAt": {"type": "string", "format": "date-time"},
    "logChunks": {
      "type": "object", "additionalProperties": false,
      "required": ["stdout", "stderr"],
      "properties": {
        "stdout": {"type": "integer", "minimum": 0},
        "stderr": {"type": "integer", "minimum": 0}
      }
    },
    "outcome": {"enum": ["completed", "infrastructure-failure", "cancelled", "timed-out"]},
    "manifestSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "reasons": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {
      "if": {"properties": {"phase": {"const": "sealed"}}, "required": ["phase"]},
      "then": {"required": ["outcome", "manifestSha256"]},
      "else": {"not": {"anyOf": [{"required": ["outcome"]}, {"required": ["manifestSha256"]}]}}
    }
  ]
}

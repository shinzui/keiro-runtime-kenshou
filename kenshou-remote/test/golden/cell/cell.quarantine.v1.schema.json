{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shinzui.dev/load-testing-infra/schemas/cell/cell.quarantine.v1.schema.json",
  "title": "Verification cell quarantine record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "cell", "reason", "runId", "at"],
  "properties": {
    "schema": {"const": "cell.quarantine/v1"},
    "cell": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,62}$"},
    "reason": {"type": "string", "minLength": 1},
    "runId": {"type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9-]{2,62}$"},
    "at": {"type": "string", "format": "date-time"}
  }
}

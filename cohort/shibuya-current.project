-- Isolated current Shibuya release lane. The full runtime cohort still pins
-- keiro-pgmq 0.17.0.0, whose shibuya-core bound excludes the 0.10 release line.
-- Cabal resolves package paths from the working directory at the repo root.
packages:
  kenshou-core/kenshou-core.cabal,
  kenshou-check/kenshou-check.cabal,
  kenshou-diagnose/kenshou-diagnose.cabal,
  kenshou-measure/kenshou-measure.cabal,
  kenshou-telemetry/kenshou-telemetry.cabal,
  kenshou-shibuya/kenshou-shibuya.cabal

with-compiler: ghc-9.12.4
index-state: 2026-10-10T19:40:06Z
tests: True
test-show-details: direct

-- The isolated lane never exercises Keiro schemas; released Keiro migration
-- bounds exclude the Kiroku schema required by shibuya-kiroku-adapter 0.6.
package kenshou-core
  flags: -keiro-schema

extra-packages:
  shibuya-metrics,
  shibuya-pgmq-adapter,
  shibuya-kiroku-adapter,
  kiroku-store,
  kiroku-store-migrations,
  pgmq-core,
  pgmq-hasql,
  pgmq-effectful,
  pgmq-migration

constraints:
  shibuya-core ==0.10.0.1,
  shibuya-metrics ==0.10.0.1,
  shibuya-pgmq-adapter ==0.16.1.0,
  shibuya-kiroku-adapter ==0.6.0.0,
  kiroku-store ==0.10.0.0,
  kiroku-store-migrations ==0.7.0.0,
  pgmq-core ==0.6.1.1,
  pgmq-hasql ==0.6.1.1,
  pgmq-effectful ==0.6.1.1,
  pgmq-migration ==0.6.1.1

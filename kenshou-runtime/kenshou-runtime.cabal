cabal-version: 3.4
name: kenshou-runtime
version: 0.1.0.0
synopsis: Assembled-runtime verification domain and scenarios
license: BSD-3-Clause
author: Nadeem Bitar
maintainer: Nadeem Bitar
category: Testing
build-type: Simple
tested-with: ghc >=9.12 && <9.13

common warnings
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints

  default-language: GHC2024
  default-extensions:
    BlockArguments
    DeriveAnyClass
    DeriveGeneric
    DuplicateRecordFields
    ImportQualifiedPost
    LambdaCase
    NoFieldSelectors
    OverloadedRecordDot
    OverloadedStrings
    QualifiedDo
    TemplateHaskell
    TypeApplications

library
  import: warnings
  hs-source-dirs: src
  exposed-modules:
    Kenshou.Suite.Runtime.Oracle.Pure
    Kenshou.Suite.Runtime.System.Broker
    Kenshou.Suite.Runtime.System.Contracts
    Kenshou.Suite.Runtime.System.Fulfilment
    Kenshou.Suite.Runtime.System.KafkaBridge
    Kenshou.Suite.Runtime.System.Ledger
    Kenshou.Suite.Runtime.System.Model
    Kenshou.Suite.Runtime.System.Order
    Kenshou.Suite.Runtime.System.SagaLog

  build-depends:
    aeson,
    base,
    bytestring,
    containers,
    effectful,
    hw-kafka-client,
    kafka-effectful,
    keiki,
    keiro,
    keiro-core,
    kenshou-core,
    kenshou-kafka,
    kenshou-keiro,
    kiroku-store,
    text,

test-suite kenshou-runtime-test
  import: warnings
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  build-depends:
    base,
    containers,
    hspec,
    keiro-core,
    kenshou-runtime,

cabal-version: 3.4
name: kenshou-runtime
version: 0.1.0.0
synopsis: Assembled-runtime verification domain and scenarios
license: BSD-3-Clause
author: Nadeem Bitar
maintainer: Nadeem Bitar
category: Testing
build-type: Simple
tested-with: ghc >=9.12 && <9.13

common warnings
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints

  default-language: GHC2024
  default-extensions:
    BlockArguments
    DeriveAnyClass
    DeriveGeneric
    DuplicateRecordFields
    ImportQualifiedPost
    LambdaCase
    NoFieldSelectors
    OverloadedRecordDot
    OverloadedStrings
    QualifiedDo
    TemplateHaskell
    TypeApplications

library
  import: warnings
  hs-source-dirs: src
  exposed-modules:
    Kenshou.Suite.Runtime
    Kenshou.Suite.Runtime.Correctness.Ops
    Kenshou.Suite.Runtime.Correctness.OrderFlow
    Kenshou.Suite.Runtime.Correctness.Telemetry
    Kenshou.Suite.Runtime.Correctness.WireRoundtrip
    Kenshou.Suite.Runtime.Driver
    Kenshou.Suite.Runtime.Knobs
    Kenshou.Suite.Runtime.Ops
    Kenshou.Suite.Runtime.Oracle
    Kenshou.Suite.Runtime.Oracle.Ops
    Kenshou.Suite.Runtime.Oracle.Pure
    Kenshou.Suite.Runtime.Oracle.Sql
    Kenshou.Suite.Runtime.Oracle.Trace
    Kenshou.Suite.Runtime.Roles
    Kenshou.Suite.Runtime.System.Broker
    Kenshou.Suite.Runtime.System.Config
    Kenshou.Suite.Runtime.System.Context
    Kenshou.Suite.Runtime.System.Contracts
    Kenshou.Suite.Runtime.System.Dispatch
    Kenshou.Suite.Runtime.System.Fulfilment
    Kenshou.Suite.Runtime.System.Intake
    Kenshou.Suite.Runtime.System.KafkaBridge
    Kenshou.Suite.Runtime.System.Ledger
    Kenshou.Suite.Runtime.System.Model
    Kenshou.Suite.Runtime.System.Order
    Kenshou.Suite.Runtime.System.SagaLog
    Kenshou.Suite.Runtime.System.Schema
    Kenshou.Suite.Runtime.System.Shop
    Kenshou.Suite.Runtime.System.Store
    Kenshou.Suite.Runtime.System.Trace
    Kenshou.Suite.Runtime.System.Warehouse
    Kenshou.Suite.Runtime.System.Wire
    Kenshou.Suite.Runtime.Telemetry
    Kenshou.Suite.Runtime.Topology

  build-depends:
    aeson,
    async,
    base,
    bytestring,
    containers,
    contravariant,
    directory,
    effectful,
    filepath,
    hasql,
    hasql-transaction,
    hs-opentelemetry-api,
    hs-opentelemetry-propagator-w3c,
    hw-kafka-client,
    kafka-effectful,
    keiki,
    keiro,
    keiro-core,
    keiro-ops,
    keiro-pgmq,
    kenshou-check,
    kenshou-core,
    kenshou-kafka,
    kenshou-keiro,
    kenshou-telemetry,
    kiroku-otel,
    kiroku-store,
    optparse-applicative,
    pgmq-core,
    scientific,
    shibuya-core,
    shibuya-kafka-adapter,
    splitmix,
    stm,
    text,
    time,
    unliftio-core,
    unordered-containers,
    uuid,

test-suite kenshou-runtime-test
  import: warnings
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  build-depends:
    aeson,
    base,
    containers,
    hspec,
    hw-kafka-client,
    keiro,
    keiro-core,
    kenshou-core,
    kenshou-runtime,
    text,
    time,

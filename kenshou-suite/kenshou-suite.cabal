cabal-version: 3.0
name: kenshou-suite
version: 0.1.0.0
synopsis: Command-line interface for Keiro runtime verification
description: Operator and automation interface for the Kenshou verification harness.
license: BSD-3-Clause
author: Nadeem Bitar
maintainer: Nadeem Bitar
category: Testing
build-type: Simple
tested-with: ghc >=9.12 && <9.13
extra-source-files:
  data/components.json
  data/kenshou.project
  data/perf-contracts.json
  fixtures/**/*.json
  fixtures/**/*.jsonl
  fixtures/**/*.txt
  test/fixtures/*.json

flag runtime-suites
  description: Link the full runtime scenario suites (disable for the isolated Shibuya cohort).
  default: True
  manual: True

common warnings
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints

  default-language: GHC2024
  default-extensions:
    BlockArguments
    DuplicateRecordFields
    ImportQualifiedPost
    NoFieldSelectors
    OverloadedLabels
    OverloadedRecordDot
    OverloadedStrings

library
  import: warnings
  hs-source-dirs: src
  exposed-modules:
    Kenshou.Suite.Attest
    Kenshou.Suite.Registry
    Kenshou.Suite.Version

  other-modules: Paths_kenshou_suite
  autogen-modules: Paths_kenshou_suite
  build-depends:
    aeson >=2.2 && <2.3,
    base >=4.21 && <4.22,
    bytestring >=0.12 && <0.13,
    file-embed >=0.0.16 && <0.1,
    filepath >=1.5 && <1.6,
    githash >=0.1.7 && <0.2,
    kenshou-cli ^>=0.1.0.0,
    kenshou-core ^>=0.1.0.0,
    kenshou-evidence ^>=0.1.0.0,
    kenshou-shibuya,
    kenshou-support,
    text >=2.1 && <2.2,

  if flag(runtime-suites)
    cpp-options: -DFULL_RUNTIME_SUITES
    build-depends:
      kenshou-kafka,
      kenshou-keiro,
      kenshou-kiroku,
      kenshou-pgmq,
      kenshou-runtime,

executable kenshou
  import: warnings
  hs-source-dirs: app
  main-is: Main.hs
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N
    -with-rtsopts=-T

  build-depends:
    base >=4.21 && <4.22,
    kenshou-cli,
    kenshou-suite,

test-suite kenshou-suite-test
  import: warnings

  if !flag(runtime-suites)
    buildable: False
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  other-modules:
    AssemblySpec
    PerfSessionSpec

  build-depends:
    aeson >=2.2 && <2.3,
    base >=4.21 && <4.22,
    bytestring,
    containers >=0.7 && <0.8,
    directory,
    filepath,
    hspec >=2.11 && <2.12,
    kenshou-cli,
    kenshou-core,
    kenshou-keiro,
    kenshou-measure,
    kenshou-remote,
    kenshou-suite,
    kenshou-support,
    kenshou-telemetry,
    temporary,
    text >=2.1 && <2.2,
    time,
    uuid,

test-suite kenshou-linkproof
  import: warnings

  if !flag(runtime-suites)
    buildable: False
  type: exitcode-stdio-1.0
  hs-source-dirs: linkproof
  main-is: Main.hs
  other-modules: LinkProof.Imports
  ghc-options: -threaded
  build-depends:
    aeson,
    base,
    effectful,
    effectful-core,
    ephemeral-pg,
    hasql,
    hasql-pool,
    hs-opentelemetry-api,
    hs-opentelemetry-exporter-in-memory,
    hs-opentelemetry-exporter-otlp,
    hs-opentelemetry-propagator-w3c,
    hs-opentelemetry-sdk,
    hs-opentelemetry-semantic-conventions,
    hspec,
    hw-kafka-client,
    hw-kafka-streamly,
    kafka-effectful,
    keiki,
    keiki-codec-json,
    keiro,
    keiro-core,
    keiro-migrations,
    keiro-ops,
    keiro-pgmq,
    keiro-test-support,
    kiroku-cli,
    kiroku-metrics,
    kiroku-otel,
    kiroku-store,
    kiroku-store-migrations,
    pg-migrate,
    pg-migrate-cli,
    pg-migrate-embed,
    pg-migrate-import-codd,
    pg-migrate-import-hasql-migration,
    pgmq-config,
    pgmq-core,
    pgmq-effectful,
    pgmq-hasql,
    pgmq-migration,
    shibuya-core,
    shibuya-kafka-adapter,
    shibuya-kiroku-adapter,
    shibuya-metrics,
    shibuya-pgmq-adapter,
    text,
    vector,
